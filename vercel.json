{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "bff": {
      "root": "bff",
      "framework": "hono"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "bff"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
